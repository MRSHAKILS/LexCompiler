# LexCompiler — JusticeSphere AI (ComplianceOS / GovernanceIQ)
PORT=3001
NODE_ENV=development
# Bind address. Defaults to loopback; any other host requires LEXCOMPILER_API_TOKEN.
HOST=127.0.0.1
# Bearer token required on every /api route except /api/health when set.
LEXCOMPILER_API_TOKEN=
# Comma-separated browser origins allowed to call the API (defaults to localhost:5173/3001).
LEXCOMPILER_ALLOWED_ORIGINS=
# Extra Host header names accepted when no token is set (DNS-rebinding guard).
LEXCOMPILER_ALLOWED_HOSTS=
# Set to 1 to enable GET /api/sandbox/verify-runtime (executes target-repo Python locally).
LEXCOMPILER_ENABLE_RUNTIME_SANDBOX=0
# Repository to scan (defaults to the bundled target-repo/ fixture).
LEXCOMPILER_TARGET_REPO=
# Where the ledger, vector store, persisted clauses and signing key are kept.
LEXCOMPILER_DATA_DIR=
# Ed25519 attestation key (PEM text or a file path); generated in the data dir when unset.
LEXCOMPILER_SIGNING_KEY_PEM=
LEXCOMPILER_SIGNING_KEY_PATH=
# OPA binary used to evaluate the generated Rego policies (defaults to `opa` on PATH).
LEXCOMPILER_OPA_BIN=
# Ollama endpoint.
OLLAMA_HOST=http://localhost:11434
# GitHub pull-request integration (POST /api/remediation/open-github-pr).
LEXCOMPILER_GITHUB_TOKEN=
LEXCOMPILER_GITHUB_REPO=
LEXCOMPILER_GITHUB_BASE=
LEXCOMPILER_GITHUB_PATH_PREFIX=
