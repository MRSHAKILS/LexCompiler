# LexCompiler — JusticeSphere AI (ComplianceOS / GovernanceIQ)
PORT=3001
NODE_ENV=development
# Bind address. Defaults to loopback; any other host requires LEXCOMPILER_API_TOKEN.
HOST=127.0.0.1
# Bearer token required on every /api route except /api/health when set.
LEXCOMPILER_API_TOKEN=
# Comma-separated browser origins allowed to call the API (defaults to localhost:5173/3001).
LEXCOMPILER_ALLOWED_ORIGINS=
# Extra Host header names accepted when no token is set (DNS-rebinding guard).
LEXCOMPILER_ALLOWED_HOSTS=
# Set to 1 to enable GET /api/sandbox/verify-runtime (executes target-repo Python locally).
LEXCOMPILER_ENABLE_RUNTIME_SANDBOX=0
