{
  "name": "justicesphere-complianceos",
  "version": "1.0.0",
  "description": "JusticeSphere AI — ComplianceOS / GovernanceIQ: Autonomous Legal-to-Formal-Logic Compiler (SMT/Z3 + OPA Rego + AST) & Continuous Code/Schema Compliance Prover",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port 5173 --host",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "verify:cli": "tsx server/cli-verify.ts",
    "verify:realworld": "tsx server/cli-realworld-demo.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "gpt-tokenizer": "4.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "z3-solver": "^4.13.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
