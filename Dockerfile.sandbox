# Image for the isolated runtime sandbox (LEXCOMPILER_SANDBOX_CONTAINER=docker, LEXCOMPILER_SANDBOX_IMAGE=lexcompiler-sandbox:1).
#   docker build -f Dockerfile.sandbox -t lexcompiler-sandbox:1 .
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*
COPY requirements-sandbox.txt /tmp/requirements-sandbox.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -q -r /tmp/requirements-sandbox.txt && rm /tmp/requirements-sandbox.txt
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
WORKDIR /work
